{
  "version": 2,
  "builds": [
    {
      "src": "ipl-engine/backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/simulate",
      "dest": "ipl-engine/backend/main.py"
    },
    {
      "src": "/standings",
      "dest": "ipl-engine/backend/main.py"
    },
    {
      "src": "/health",
      "dest": "ipl-engine/backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
