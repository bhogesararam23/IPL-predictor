{
  "version": 2,
  "builds": [
    {
      "src": "ipl-engine/backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "ipl-engine/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/simulate",
      "destination": "/ipl-engine/backend/main.py"
    },
    {
      "source": "/standings",
      "destination": "/ipl-engine/backend/main.py"
    },
    {
      "source": "/health",
      "destination": "/ipl-engine/backend/main.py"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/ipl-engine/frontend/assets/$1"
    },
    {
      "source": "/vite.svg",
      "destination": "/ipl-engine/frontend/vite.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/ipl-engine/frontend/index.html"
    }
  ]
}
